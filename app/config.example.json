{
  "name": "小助理",
  "owner_name": "张三",
  "owner_open_id": "ou_主人的open_id（scripts/ids.sh 查）",
  "bot_open_id": "ou_机器人的open_id（scripts/ids.sh 查）",
  "channels": {
    "feishu": {
      "enabled": true
    },
    "wecom": {
      "enabled": false,
      "owner_userid": "主人的企微 userid（启用后主人私聊机器人一句，在日志 recv 行里看）",
      "credentials": "wecom-cli"
    }
  },
  "cross_im_read": false,
  "tasks": {
    "enabled": true,
    "root": "~/work/.bot-tasks",
    "approval_hours": 24,
    "heartbeat_min": 30,
    "models": [
      "haiku",
      "sonnet",
      "opus"
    ],
    "budget_default": 20,
    "budget_factor": 1.5,
    "quota_alert": {
      "five_hour": 0.85,
      "seven_day_pace": 1.1
    },
    "sibling_warm_min": 55,
    "sibling_max_ctx": 150000,
    "compact": {
      "idle_min": 50,
      "min_ctx": 120000
    },
    "stuck_min": 40,
    "verify_retries": 2,
    "verify_timeout_min": 20,
    "cloud": {
      "environment_id": "",
      "timeout_min": 180
    },
    "project_alias": {},
    "resources": {
      "floor_gb": 1.5,
      "floor_pct": 10,
      "pressure_pct": 20,
      "max_units": 8,
      "default_build_gb": 4,
      "default_light_gb": 1,
      "freeze_gb": 0.75,
      "freeze_pressure_pct": 60,
      "thaw_after_s": 60
    }
  },
  "persona": "work",
  "style": "veteran",
  "workdir": "~/work",
  "add_dirs": [
    "~/wiki"
  ],
  "permission_mode": "auto",
  "identity": {
    "owner": "user_no_speak",
    "others": "bot_read_im"
  },
  "context": {
    "enabled": true,
    "max": 20,
    "topic_max": 50,
    "group_window_h": 2,
    "p2p_window_h": 24,
    "max_chars": 400,
    "read_as": "user"
  },
  "ambient": {
    "enabled": true,
    "poll_seconds": 40,
    "quiet_seconds": 25,
    "max_wait_seconds": 180,
    "max_batch": 30,
    "cooldown_min": 10,
    "rotate_turns": 40,
    "command": "/listen"
  },
  "private": {
    "paths": [
      "~/personal",
      "/\\.private(/|\\b)",
      "~/.claude/projects",
      "~/.claude/history"
    ],
    "search_roots": [
      {
        "root": "~/notes/kb",
        "exclude": [
          "**/people/**",
          "**/entities/People*",
          "**/daily/**",
          "**/drafts/**"
        ]
      }
    ]
  },
  "deny_extra": [],
  "chat_max_turns": 60,
  "credential_paths": [
    "~/.config/codeup",
    "~/.git-credentials"
  ],
  "prime": true,
  "mcp_open_to": [],
  "command_guard": [],
  "p2p_idle_hours": 6,
  "group_idle_hours": 2,
  "max_parallel": 3,
  "claude_timeout_min": 40,
  "timezone": "Asia/Shanghai",
  "devices": [],
  "irreversible": [
    "\\bgit\\s+push\\b.*(--tags|\\brefs/tags/)",
    "\\bgh\\s+release\\s+create\\b",
    "\\bnpm\\s+publish\\b"
  ],
  "schedules": {
    "max_run_min": 120,
    "fail_pause": 3,
    "min_wake_min": 5,
    "probe_timeout_s": 60,
    "probe_mem_mb": 1024
  },
  "routing": {
    "sticky_min": 30,
    "fast_path": {
      "max_chars": 20
    }
  },
  "delivery": {
    "max_hops": 3,
    "owner_max_chars": 300,
    "other_max_chars": 2000,
    "dedup_min": 30,
    "progress_gap_min": 10,
    "progress_max": 5,
    "owner_per_10min": 4,
    "owner_per_hour": 12,
    "pingpong_max": 3,
    "pingpong_min": 10,
    "merge_s": 120
  }
}
